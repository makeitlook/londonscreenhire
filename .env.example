# Web3Forms access key for the quote/contact form.
# Get your free key at https://web3forms.com
# Copy this file to .env.local and fill in your key.
# .env.local is gitignored and must never be committed.
#
# The key is prefixed NEXT_PUBLIC_ because the quote form
# submits directly from the browser to the Web3Forms API.
# No server-side route is involved.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
